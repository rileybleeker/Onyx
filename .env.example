# Onyx — Python ETL secrets (root .env). Copy to .env and fill in your values.
# .env is gitignored; NEVER commit real values.
#   cp .env.example .env   (then edit)

# --- Supabase (app.supabase.com -> Project -> Settings -> API) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Garmin Connect ---
GARMIN_EMAIL=
GARMIN_PASSWORD=

# --- WHOOP (developer.whoop.com OAuth app) ---
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# --- Eight Sleep ---
EIGHTSLEEP_EMAIL=
EIGHTSLEEP_PASSWORD=
EIGHTSLEEP_CLIENT_ID=
EIGHTSLEEP_CLIENT_SECRET=

# --- IMAP (MyFitnessPal export email import; Gmail app password) ---
IMAP_HOST=imap.gmail.com
IMAP_EMAIL=
IMAP_APP_PASSWORD=

# --- MyFitnessPal (legacy archive path) ---
MFP_USERNAME=
MFP_PASSWORD=

# --- Cronometer (email + password, no 2FA) ---
CRONOMETER_EMAIL=
CRONOMETER_PASSWORD=

# --- Spotify (developer.spotify.com; set redirect URI to the value below) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Tanita Health Planet (healthplanet.jp; redirect https://www.healthplanet.jp/success.html) ---
TANITA_CLIENT_ID=
TANITA_CLIENT_SECRET=

# --- Notion (internal integration token; share the Journal DB with it) ---
NOTION_API_KEY=
NOTION_JOURNAL_DB=

# --- Voyage AI (journal embeddings) ---
VOYAGE_API_KEY=

# --- Audit tooling (audit_runner.py) — optional ---
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
