# Onyx frontend (Next.js) — copy to .env.local and fill in.
#   cp .env.local.example .env.local   (then edit)

# --- Supabase (public, browser-exposed) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only, service role) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (AI chat + supplement photo extraction) ---
ANTHROPIC_API_KEY=

# --- Notion (habits sync) ---
NOTION_API_KEY=
NOTION_HABITS_DB=

# --- Voyage AI (semantic journal search embeddings at request time) ---
VOYAGE_API_KEY=

# --- Spotify (playlist tools + the Reconnect on /status; the same app as the GitHub Actions secrets) ---
# The redirect address is fixed in code (lib/spotify-reconnect.ts); there is no SPOTIFY_REDIRECT_URI here.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Shared CI secret gating /api/habits/* (must match GitHub Actions + Vercel Production) ---
ONYX_CI_TOKEN=

# --- Playwright smoke tests (optional; use a real app account) ---
SMOKE_TEST_EMAIL=
SMOKE_TEST_PASSWORD=
SMOKE_BASE_URL=
